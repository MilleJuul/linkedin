# Lokalt: lad denne stå tom; filer gemmes i public/uploads/ i stedet.
# På Vercel: sættes automatisk når du tilføjer Blob storage i projektet.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

