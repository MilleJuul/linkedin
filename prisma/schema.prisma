// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  EDITOR
  APPROVER
}

enum PostStatus {
  DRAFT
  REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum Platform {
  LINKEDIN
}

enum AssetType {
  IMAGE
  VIDEO
}

enum ImportBatchStatus {
  PROCESSING
  DONE
  PARTIAL
  FAILED
}

enum InsightTimeframe {
  SEVEN_DAYS
  THIRTY_DAYS
  NINETY_DAYS
  ALL_TIME
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  passwordHash  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships    WorkspaceMember[]
  posts          Post[]            @relation("PostCreatedBy")
  updatedPosts   Post[]            @relation("PostUpdatedBy")
  comments       Comment[]
  auditEvents    AuditEvent[]
  accounts       Account[]
  sessions       Session[]
  importBatches  ImportBatch[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members         WorkspaceMember[]
  brandKit        BrandKit?
  assets          Asset[]
  posts           Post[]
  importBatches   ImportBatch[]
  importedPosts   ImportedPost[]
  insightAggregates InsightAggregate[]
  winningPatterns WinningPattern[]
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        Role      @default(EDITOR)
  joinedAt    DateTime  @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model BrandKit {
  id            String   @id @default(cuid())
  workspaceId   String   @unique
  toneOfVoice   String   @default("")
  doWords       String[] @default([])
  dontWords     String[] @default([])
  ctaStyle      String   @default("")
  hashtagStyle  String   @default("")
  emojiPolicy   String   @default("")
  examples      String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Asset {
  id           String    @id @default(cuid())
  workspaceId  String
  type         AssetType @default(IMAGE)
  url          String
  thumbnailUrl String?
  filename     String
  tags         String[]  @default([])
  createdAt    DateTime  @default(now())

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Post {
  id          String     @id @default(cuid())
  workspaceId String
  title       String
  status      PostStatus @default(DRAFT)
  platform    Platform   @default(LINKEDIN)
  scheduledAt DateTime?
  bodyText    String     @default("")
  hook        String     @default("")
  cta         String     @default("")
  hashtags    String[]   @default([])
  assetIds    String[]   @default([])
  createdById String
  updatedById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User       @relation("PostCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?      @relation("PostUpdatedBy", fields: [updatedById], references: [id])
  comments    Comment[]
  auditEvents AuditEvent[]
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  body      String
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
}

model AuditEvent {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  userId     String
  createdAt  DateTime @default(now())
  diffJson   Json?

  user       User     @relation(fields: [userId], references: [id])
  post       Post?    @relation(fields: [entityId], references: [id], map: "AuditEvent_postId_fkey")
}

// ─── CSV Import ───────────────────────────────────────────────────────────────

model ImportBatch {
  id               String            @id @default(cuid())
  workspaceId      String
  source           String            @default("hootsuite")
  uploadedByUserId String
  uploadedAt       DateTime          @default(now())
  originalFilename String
  rowCount         Int               @default(0)
  importedCount    Int               @default(0)
  updatedCount     Int               @default(0)
  status           ImportBatchStatus @default(PROCESSING)
  errors           Json?

  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedBy   User                 @relation(fields: [uploadedByUserId], references: [id])
  snapshots    PostMetricSnapshot[]

  @@index([workspaceId])
  @@index([uploadedAt])
}

model ImportedPost {
  id          String   @id @default(cuid())
  workspaceId String
  externalId  String?
  platform    String   @default("linkedin")
  text        String   @db.Text
  contentHash String
  publishedAt DateTime
  isPartial   Boolean  @default(false)
  createdAt   DateTime @default(now())

  workspace Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  snapshots PostMetricSnapshot[]

  @@unique([workspaceId, contentHash])
  @@index([workspaceId])
  @@index([publishedAt])
  @@index([workspaceId, publishedAt])
}

model PostMetricSnapshot {
  id             String   @id @default(cuid())
  postId         String
  batchId        String
  impressions    Int?
  likes          Int?
  comments       Int?
  shares         Int?
  clicks         Int?
  reach          Int?
  engagementRate Float?
  ctr            Float?
  isPartial      Boolean  @default(false)
  createdAt      DateTime @default(now())

  post  ImportedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  batch ImportBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([batchId])
  @@index([createdAt])
}

model InsightAggregate {
  id                String           @id @default(cuid())
  workspaceId       String
  timeframe         InsightTimeframe
  totalImpressions  Int              @default(0)
  totalReactions    Int              @default(0)
  totalComments     Int              @default(0)
  totalShares       Int              @default(0)
  totalClicks       Int              @default(0)
  postCount         Int              @default(0)
  engagementRateAvg Float            @default(0)
  ctrAvg            Float            @default(0)
  deltaVsPrev       Json?
  generatedAt       DateTime         @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, timeframe])
  @@index([workspaceId, generatedAt])
}

model WinningPattern {
  id             String   @id @default(cuid())
  workspaceId    String
  hookType       String
  avgEngRate     Float    @default(0)
  avgImpressions Float    @default(0)
  exampleTexts   String[] @default([])
  features       Json
  postCount      Int      @default(0)
  updatedAt      DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@unique([workspaceId, hookType])
}
